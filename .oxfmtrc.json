{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "printWidth": 100,
  "trailingComma": "all",
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    ".build/**",
    "test-results/**",
    "playwright-report/**",
    "pnpm-lock.yaml",
    "public/fonts/**"
  ]
}
