{
  "name": "lg-luma",
  "version": "0.1.7",
  "private": true,
  "description": "A modern, remote-first webOS launcher.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm check && node tools/build.mjs",
    "package": "pnpm build && node tools/package.mjs && node tools/repository.mjs",
    "deploy": "pnpm run package && node tools/deploy.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "check": "pnpm lint && pnpm typecheck",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "screenshots": "pnpm build && node tools/screenshots.mjs",
    "assets": "node tools/assets.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "motion": "^12.23.24",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@webos-tools/cli": "3.2.6",
    "esbuild": "^0.27.0",
    "oxlint": "1.88.0",
    "oxfmt": "0.73.0",
    "sharp": "0.35.5",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "8.3.4"
  }
}
